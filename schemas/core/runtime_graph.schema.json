{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://romi.dev/schemas/core/runtime_graph.schema.json",
  "title": "RoMi Runtime Graph",
  "description": "Draft runtime graph schema for nodes, streams, and dataflow edges.",
  "type": "object",
  "required": [
    "schema_version",
    "graph_id",
    "nodes",
    "edges"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "graph_id": {
      "type": "string"
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "node_id",
          "kind"
        ],
        "properties": {
          "node_id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "bridge",
              "recorder",
              "replay_source",
              "synchronizer",
              "policy",
              "diagnostics",
              "dataset_view",
              "safety_gate"
            ]
          },
          "lifecycle_state": {
            "type": "string"
          },
          "metadata": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "additionalProperties": false
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to",
          "stream_id"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "stream_id": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
