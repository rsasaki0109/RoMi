{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://romi.dev/schemas/core/dataset_report.schema.json",
  "title": "RoMi Dataset Inspection Report",
  "description": "Draft schema for the committed navigation/manipulation dataset inspection report.",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "generated_at_unix_ns",
    "episode_dir",
    "episode",
    "streams",
    "diagnostics",
    "policy",
    "observation_window"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "kind": {
      "type": "string",
      "const": "dataset_inspection_report"
    },
    "generated_at_unix_ns": {
      "type": "integer",
      "minimum": 0
    },
    "episode_dir": {
      "type": "string"
    },
    "episode": {
      "type": "object",
      "required": [
        "episode_id",
        "scenario",
        "clock",
        "runtime_graph"
      ],
      "properties": {
        "episode_id": {
          "type": "string"
        },
        "scenario": {
          "type": "object",
          "required": [
            "name",
            "mode",
            "world_id",
            "robot_id"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "mode": {
              "type": "string"
            },
            "world_id": {
              "type": "string"
            },
            "robot_id": {
              "type": "string"
            }
          },
          "additionalProperties": true
        },
        "clock": {
          "type": "object",
          "required": [
            "clock_domain",
            "start_time_ns",
            "end_time_ns"
          ],
          "properties": {
            "clock_domain": {
              "type": "string"
            },
            "start_time_ns": {
              "type": "integer",
              "minimum": 0
            },
            "end_time_ns": {
              "type": "integer",
              "minimum": 0
            },
            "replay_time_scale": {
              "type": "number",
              "minimum": 0
            }
          },
          "additionalProperties": true
        },
        "runtime_graph": {
          "type": "object",
          "required": [
            "graph_id",
            "nodes"
          ],
          "properties": {
            "graph_id": {
              "type": "string"
            },
            "nodes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "streams": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "stream_id",
          "semantic_type",
          "message_count",
          "clock_domain",
          "frame_ids"
        ],
        "properties": {
          "stream_id": {
            "type": "string"
          },
          "semantic_type": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_topic": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_message_type": {
            "type": [
              "string",
              "null"
            ]
          },
          "message_count": {
            "type": "integer",
            "minimum": 0
          },
          "clock_domain": {
            "type": [
              "string",
              "null"
            ]
          },
          "frame_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "first_event_time_ns": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "last_event_time_ns": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    },
    "diagnostics": {
      "type": "object",
      "required": [
        "event_count",
        "by_severity",
        "by_category"
      ],
      "properties": {
        "event_count": {
          "type": "integer",
          "minimum": 0
        },
        "by_severity": {
          "type": "object",
          "additionalProperties": true
        },
        "by_category": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "policy": {
      "type": "object",
      "required": [
        "sample_count",
        "freshness_status",
        "actions"
      ],
      "properties": {
        "sample_count": {
          "type": "integer",
          "minimum": 0
        },
        "freshness_status": {
          "type": "object",
          "additionalProperties": true
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "event_time_ns",
              "inference_latency_ms",
              "authority",
              "proposed_action_count",
              "proposed_actions"
            ],
            "properties": {
              "event_time_ns": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "inference_latency_ms": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "authority": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "proposed_action_count": {
                "type": "integer",
                "minimum": 0
              },
              "proposed_actions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "observation_window": {
      "type": "object",
      "required": [
        "target_time_ns",
        "window_start_time_ns",
        "window_end_time_ns",
        "window_ms",
        "required_stream_count",
        "available_stream_count",
        "missing_stream_count",
        "streams"
      ],
      "properties": {
        "target_time_ns": {
          "type": "integer",
          "minimum": 0
        },
        "window_start_time_ns": {
          "type": "integer",
          "minimum": 0
        },
        "window_end_time_ns": {
          "type": "integer",
          "minimum": 0
        },
        "window_ms": {
          "type": "number",
          "minimum": 0
        },
        "required_stream_count": {
          "type": "integer",
          "minimum": 0
        },
        "available_stream_count": {
          "type": "integer",
          "minimum": 0
        },
        "missing_stream_count": {
          "type": "integer",
          "minimum": 0
        },
        "streams": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "stream_id",
              "semantic_type",
              "source_topic",
              "source_message_type",
              "payload_schema_id",
              "status",
              "delta_ms",
              "delta_abs_ms",
              "event_time_ns",
              "frame_id",
              "sample_index",
              "payload_summary"
            ],
            "properties": {
              "stream_id": {
                "type": "string"
              },
              "semantic_type": {
                "type": [
                  "string",
                  "null"
                ],
                "enum": [
                  "rgb_image",
                  "depth_image",
                  "camera_info",
                  "joint_state",
                  "odometry",
                  "transform_tree",
                  "task_goal",
                  null
                ]
              },
              "source_topic": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "source_message_type": {
                "type": [
                  "string",
                  "null"
                ],
                "enum": [
                  "romi.robotics.ImageSummary",
                  "romi.robotics.CameraInfoSummary",
                  "romi.robotics.JointStateSummary",
                  "romi.robotics.OdometrySummary",
                  "romi.robotics.TransformTreeSummary",
                  "romi.robotics.PoseGoalSummary",
                  null
                ]
              },
              "payload_schema_id": {
                "type": [
                  "string",
                  "null"
                ],
                "enum": [
                  "https://romi.dev/schemas/robotics/image_summary.schema.json",
                  "https://romi.dev/schemas/robotics/camera_info_summary.schema.json",
                  "https://romi.dev/schemas/robotics/joint_state_summary.schema.json",
                  "https://romi.dev/schemas/robotics/odometry_summary.schema.json",
                  "https://romi.dev/schemas/robotics/transform_tree_summary.schema.json",
                  "https://romi.dev/schemas/robotics/task_goal_summary.schema.json",
                  null
                ]
              },
              "status": {
                "type": "string",
                "enum": [
                  "ok",
                  "missing_in_window"
                ]
              },
              "delta_ms": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "delta_abs_ms": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "event_time_ns": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "frame_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "sample_index": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "payload_summary": {
                "type": [
                  "object",
                  "null"
                ],
                "additionalProperties": true
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
