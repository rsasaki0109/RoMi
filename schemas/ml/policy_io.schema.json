{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://romi.dev/schemas/ml/policy_io.schema.json",
  "title": "RoMi Policy IO",
  "description": "Draft schema for policy observations and non-authoritative proposed actions.",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "policy_id",
    "time",
    "input_streams",
    "freshness",
    "proposed_actions",
    "inference_latency_ms",
    "metadata"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "kind": {
      "type": "string",
      "const": "proposed_action"
    },
    "policy_id": {
      "type": "string"
    },
    "time": {
      "type": "object",
      "required": [
        "event_time_ns",
        "clock_domain"
      ],
      "properties": {
        "event_time_ns": {
          "type": "integer",
          "minimum": 0
        },
        "clock_domain": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "input_streams": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "freshness": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "age_ms",
          "status",
          "required"
        ],
        "properties": {
          "age_ms": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "fresh",
              "stale",
              "future",
              "missing"
            ]
          },
          "required": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "proposed_actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "target",
          "action_type",
          "authority"
        ],
        "properties": {
          "target": {
            "type": "string",
            "enum": [
              "base",
              "end_effector",
              "gripper"
            ]
          },
          "action_type": {
            "type": "string",
            "enum": [
              "navigate_to_goal",
              "hold_position",
              "hold_ready_pose",
              "carry_object",
              "reach_target",
              "hold_until_inputs_fresh",
              "hold_open",
              "hold_closed",
              "hold_last_safe",
              "prepare_grasp"
            ]
          },
          "values": {
            "type": "object",
            "additionalProperties": true
          },
          "authority": {
            "type": "string",
            "const": "proposed_only"
          }
        },
        "additionalProperties": false
      }
    },
    "observation_window": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "stream_id",
          "status",
          "age_ms",
          "frame_id",
          "semantic_type",
          "sample_index"
        ],
        "properties": {
          "stream_id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "fresh",
              "stale",
              "missing"
            ]
          },
          "age_ms": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "frame_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "semantic_type": {
            "type": [
              "string",
              "null"
            ]
          },
          "sample_index": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    },
    "input_status": {
      "type": "object",
      "required": [
        "fresh",
        "stale",
        "missing",
        "required"
      ],
      "properties": {
        "fresh": {
          "type": "integer",
          "minimum": 0
        },
        "stale": {
          "type": "integer",
          "minimum": 0
        },
        "missing": {
          "type": "integer",
          "minimum": 0
        },
        "required": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "safety_boundary": {
      "type": "object",
      "required": [
        "policy_authority",
        "actuator_authority",
        "command_stream_emitted",
        "blocked_reason"
      ],
      "properties": {
        "policy_authority": {
          "type": "string",
          "const": "proposed_only"
        },
        "actuator_authority": {
          "type": "string",
          "const": "none"
        },
        "command_stream_emitted": {
          "type": "boolean",
          "const": false
        },
        "promotion_required": {
          "type": "string"
        },
        "blocked_reason": {
          "type": "string",
          "const": "proposal_not_actuator_authority"
        }
      },
      "additionalProperties": false
    },
    "inference_latency_ms": {
      "type": "number",
      "minimum": 0
    },
    "metadata": {
      "type": "object",
      "required": [
        "authority"
      ],
      "properties": {
        "authority": {
          "type": "string",
          "const": "proposed_only"
        },
        "trigger_stream": {
          "type": [
            "string",
            "null"
          ]
        },
        "sequence_index": {
          "type": "integer",
          "minimum": 0
        },
        "scenario_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
