      "frame_id": "camera_depth_optical_frame",
      "expected_rate_hz": 30.0,
      "required": true
    },
    {
      "stream_id": "robot.camera.info",
      "semantic_type": "camera_info",
      "source_topic": "/camera/color/camera_info",
